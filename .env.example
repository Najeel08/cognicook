# Environment-variable examples; a local .env file is optional and intentionally ignored.
# Use a secret manager or protected deployment variables in production.
COGNICOOK_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
COGNICOOK_TRUSTED_HOSTS=localhost,127.0.0.1

# Storage and startup behavior.
COGNICOOK_DATA_DIR=instance
COGNICOOK_DB_PATH=instance/cognicook.db
COGNICOOK_DATASET_PATH=dataset/recipes.csv
AUTO_BOOTSTRAP_DATA=1

# HTTPS and proxy settings. Production enables secure cookies and HSTS by default.
SESSION_COOKIE_SECURE=0
SECURITY_HSTS_ENABLED=0
SECURITY_HSTS_MAX_AGE=31536000
AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS=0
AUTH_RATE_LIMIT_TRUSTED_PROXIES=
