# Cogni Cook Environment Configuration

# Application Environment (development | production)
COGNICOOK_ENV=development

# Secret key for session management (required in production)
# SECRET_KEY=your-secret-key-here

# Optional: Custom database and dataset paths
# COGNICOOK_DATA_DIR=instance
# COGNICOOK_DB_PATH=instance/cognicook.db
# COGNICOOK_DATASET_PATH=dataset/recipes.csv

# Optional: Security and cookie settings
# SESSION_COOKIE_SECURE=0
# SECURITY_HSTS_ENABLED=0
# COGNICOOK_TRUSTED_HOSTS=127.0.0.1,localhost
